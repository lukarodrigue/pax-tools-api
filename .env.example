# Uso no SERVIDOR. Copie para .env:  cp .env.example .env
POSTGRES_USER=pax
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=paxtools

# true quando estiver atras de HTTPS (Caddy). false se rodar em HTTP puro na LAN.
COOKIE_SEGURO=true

# So preencha se a API ganhar um hostname proprio, separado do front.
# Com o Caddy roteando /api no mesmo dominio, deixe vazio.
ORIGENS_PERMITIDAS=

# DATABASE_URL nao entra aqui: o compose monta apontando para o servico "banco".
