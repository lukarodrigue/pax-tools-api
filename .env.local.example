# Uso LOCAL. Copie para .env:  cp .env.local.example .env
#
# As tres POSTGRES_* o docker-compose usa para criar o banco.
# DATABASE_URL e COOKIE_SEGURO a API le quando roda no seu host.
# Precisam estar todas no MESMO arquivo.
POSTGRES_USER=pax
POSTGRES_PASSWORD=local
POSTGRES_DB=paxtools

DATABASE_URL=postgresql://pax:local@localhost:5432/paxtools
COOKIE_SEGURO=false

# O Vite roda em 5173 e repassa /api para a 3000, entao a origem ja e a
# mesma. Isto so e usado se voce chamar a API direto de outra porta.
ORIGENS_PERMITIDAS=http://localhost:5173
